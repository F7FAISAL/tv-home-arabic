<?xml version="1.0" encoding="utf-8"?>
<!-- Clean view: clear over the top of the wallpaper, then down to about 85% black at the bottom, so the info row
     stays readable over a bright photo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:type="linear"
        android:startColor="#00000000"
        android:centerColor="#26000000"
        android:centerY="0.5"
        android:endColor="#D9000000" />
</shape>
