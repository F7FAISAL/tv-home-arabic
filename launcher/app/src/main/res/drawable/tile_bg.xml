<?xml version="1.0" encoding="utf-8"?>
<!-- Behind an icon tile, or a banner with transparent parts: the top bar pills' frosted glass (pill_bg), with the
     tile's 16dp corners. An opaque banner covers it and draws no background (AppAdapter). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
    <stroke android:width="1dp" android:color="#38FFFFFF" />
    <corners android:radius="16dp" />
</shape>
