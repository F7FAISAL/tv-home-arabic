<?xml version="1.0" encoding="utf-8"?>
<!-- The clean view's round buttons (menu and screensaver): the top bar pills' frosted glass (pill_bg), white when
     focused; their icons follow pill_text, dark on the white. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
