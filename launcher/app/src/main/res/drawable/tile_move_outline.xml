<?xml version="1.0" encoding="utf-8"?>
<!-- The tile being moved («تحريك»), over its artwork: the focus glass's light white fill (7%), a thin white outline, and a
     small four-way arrows badge in the top corner, so the app's logo stays clearly visible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12FFFFFF" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:gravity="top|right" android:width="30dp" android:height="30dp" android:top="8dp" android:right="8dp">
        <shape android:shape="oval">
            <solid android:color="#99000000" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_move" android:gravity="top|right" android:width="18dp" android:height="18dp"
        android:top="14dp" android:right="14dp" />
</layer-list>
